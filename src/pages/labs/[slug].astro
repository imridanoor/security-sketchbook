---
import { getCollection, render } from 'astro:content';
import CollectionEntryLayout from '../../layouts/CollectionEntryLayout.astro';

export async function getStaticPaths() {
  const labs = await getCollection('labs');

  return labs.map((lab) => ({
    params: { slug: lab.id },
    props: { lab },
  }));
}

const { lab } = Astro.props;
const { Content } = await render(lab);
---

<CollectionEntryLayout
  title={lab.data.title}
  description={lab.data.description}
  date={lab.data.date}
>
  <Content />
</CollectionEntryLayout>