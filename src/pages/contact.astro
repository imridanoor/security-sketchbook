      <h1>Contact</h1>
      <p>Ways to connect with me professionally.</p>
    </section>

    <section class="card-grid">
      <article class="card">
        <h2>Email</h2>
        <p class="card-description">
          <a href="mailto:imridanoor@gmail.com">imridanoor@gmail.com</a>
        </p>
      </article>

      <article class="card">
        <h2>LinkedIn</h2>
        <p class="card-description">
          <a href="https://www.linkedin.com/in/im-rida-noor/" target="_blank" rel="noopener noreferrer">
            linkedin.com/in/im-rida-noor
          </a>
        </p>
