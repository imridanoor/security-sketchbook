---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sanity } from "../lib/sanity";

const latestBlog = await sanity.fetch(`
  *[_type == "blogPost"] | order(publishedAt desc)[0]{
    title,
    excerpt,
    "slug": slug.current
  }
`);

const latestLab = await sanity.fetch(`
  *[_type == "labPost"] | order(publishedAt desc)[0]{
    title,
    excerpt,
    "slug": slug.current
  }
`);

const latestSketch = await sanity.fetch(`
  *[_type == "sketchbookPost"] | order(publishedAt desc)[0]{
    title,
    excerpt,
    "slug": slug.current
  }
`);
---

<BaseLayout title="Security Sketchbook">
  <main class="homepage-shell">

    <section class="hero">
  <div class="hero-bg"></div>

  <div class="hero-content">
    <h1>
      <span class="hero-kicker">Rida's</span>
      <span class="hero-main">Security Sketchbook</span>
    </h1>

    <p class="hero-subtitle">
      A visual notebook where I document cybersecurity
      labs, investigations, and security concepts through
      diagrams.
    </p>

    <a href="/notebook" class="hero-button">Open the Notebook</a>
  </div>
</section>

    <section class="homepage-intro">
      <h2>Welcome to my sketchbook</h2>
      <p>
        Security Sketchbook is my personal space for learning cybersecurity out loud.
        I use it to work through concepts visually, document hands-on labs, and turn
        investigations into something I can understand and revisit later.
      </p>
    </section>

    <section class="recent-section">
  <h2 class="section-heading">Recent From the Notebook</h2>

  <div class="recent-grid">

    {latestLab && (
      <article class="recent-card">
        <span class="recent-tag lab">Lab</span>

        <a class="recent-title" href={`/labs/${latestLab.slug}`}>
          {latestLab.title}
        </a>

        {latestLab.excerpt && (
          <p class="recent-excerpt">{latestLab.excerpt}</p>
        )}
      </article>
    )}

    {latestBlog && (
      <article class="recent-card">
        <span class="recent-tag blog">Blog</span>

        <a class="recent-title" href={`/blog/${latestBlog.slug}`}>
          {latestBlog.title}
        </a>

        {latestBlog.excerpt && (
          <p class="recent-excerpt">{latestBlog.excerpt}</p>
        )}
      </article>
    )}

    {latestSketch && (
      <article class="recent-card">
        <span class="recent-tag sketch">Sketch</span>

        <a class="recent-title" href={`/sketchbook/${latestSketch.slug}`}>
          {latestSketch.title}
        </a>

        {latestSketch.excerpt && (
          <p class="recent-excerpt">{latestSketch.excerpt}</p>
        )}
      </article>
    )}

  </div>
</section>

<section class="explore-section" id="explore">
  <h2 class="section-heading">Explore the Notebook</h2>

  <div class="homepage-grid">
    <article class="homepage-card">
      <h3>
        <a href="/labs" class="card-section-link">Labs</a>
      </h3>

      <p>
        Hands-on exercises, walkthroughs, and experiments as I build practical security skills.
      </p>

      {latestLab ? (
        <div class="latest-preview">
          <a class="latest-title" href={`/labs/${latestLab.slug}`}>
            {latestLab.title}
          </a>

          {latestLab.excerpt && (
            <p class="latest-excerpt">{latestLab.excerpt}</p>
          )}
        </div>
      ) : (
        <p class="latest-empty">No lab posts yet.</p>
      )}
    </article>

    <article class="homepage-card">
      <h3>
        <a href="/sketchbook" class="card-section-link">Sketchbook</a>
      </h3>

      <p>
        Visual explanations of security systems, workflows, and concepts reimagined through diagrams.
      </p>

      {latestSketch ? (
        <div class="latest-preview">
          <a class="latest-title" href={`/sketchbook/${latestSketch.slug}`}>
            {latestSketch.title}
          </a>

          {latestSketch.excerpt && (
            <p class="latest-excerpt">{latestSketch.excerpt}</p>
          )}
        </div>
      ) : (
        <p class="latest-empty">No sketchbook posts yet.</p>
      )}
    </article>

    <article class="homepage-card">
      <h3>
        <a href="/blog" class="card-section-link">Blog</a>
      </h3>

      <p>
        Reflections, concept writeups, and longer thoughts on what I’m learning in cybersecurity.
      </p>

      {latestBlog ? (
        <div class="latest-preview">
          <a class="latest-title" href={`/blog/${latestBlog.slug}`}>
            {latestBlog.title}
          </a>

          {latestBlog.excerpt && (
            <p class="latest-excerpt">{latestBlog.excerpt}</p>
          )}
        </div>
      ) : (
        <p class="latest-empty">No blog posts yet.</p>
      )}
    </article>
  </div>
</section>

<section class="about-section">
  <div class="about-grid">
    <div class="about-text">
      <h2>Hi, I’m Rida.</h2>

      <p>
        I’m a SOC analyst documenting cybersecurity concepts
        the way I learn them — through diagrams, labs,
        and investigations.
      </p>

      <p>
        This site is my personal security notebook.
      </p>
    </div>

    <div class="about-image">
      <img src="/images/rida-drawing.png" alt="Rida drawing security diagrams" />
    </div>
  </div>
</section>

</main>

</BaseLayout>