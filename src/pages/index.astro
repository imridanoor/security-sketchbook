---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const blogPosts = await getCollection('blog');
const labPosts = await getCollection('labs');
const sketchPosts = await getCollection('sketchbook');

const sortByDate = (
  a: CollectionEntry<'blog'> | CollectionEntry<'labs'> | CollectionEntry<'sketchbook'>,
  b: CollectionEntry<'blog'> | CollectionEntry<'labs'> | CollectionEntry<'sketchbook'>
) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime();

const latestBlog = [...blogPosts].sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
)[0];

const latestLab = [...labPosts].sort(
  (a: CollectionEntry<'labs'>, b: CollectionEntry<'labs'>) =>
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
)[0];

const latestSketch = [...sketchPosts].sort(
  (a: CollectionEntry<'sketchbook'>, b: CollectionEntry<'sketchbook'>) =>
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
)[0];
---

<BaseLayout title="Security Sketchbook">
  <main class="container homepage-shell">
    <section class="hero">
      <h1>
        <span class="hero-kicker">Rida's</span>
        <span class="hero-main">Security Sketchbook</span>
      </h1>

      <p class="hero-subtitle">
        Visualizing cybersecurity concepts through diagrams and investigations.
      </p>
    </section>

    <section class="homepage-grid">
      <article class="homepage-card intro-card">
        <h2>What is Security Sketchbook?</h2>
        <p>
          This site is my personal notebook for learning cybersecurity.
          I document things I'm studying, diagrams I'm drawing, and
          investigations I'm working through.
        </p>
      </article>

      <article class="homepage-card">
        <h2>Sketchbook</h2>
        <p>
          Visit my visual diagrams of security systems and concepts re-imagined.
        </p>

        {latestSketch ? (
          <div class="latest-preview">
            <p class="latest-label">Latest post</p>
            <a
              class="latest-title"
              href={`/sketchbook/${latestSketch.id.replace(/\.md$/, '')}/`}
            >
              {latestSketch.data.title}
            </a>
            <p class="latest-excerpt">
              {latestSketch.data.description}
            </p>
          </div>
        ) : (
          <p class="latest-empty">No sketchbook posts yet.</p>
        )}
      </article>

      <article class="homepage-card">
        <h2>Blog</h2>
        <p>
          Explore my explanations of concepts and ideas.
        </p>

        {latestBlog ? (
          <div class="latest-preview">
            <p class="latest-label">Latest post</p>
            <a
              class="latest-title"
              href={`/blog/${latestBlog.id.replace(/\.md$/, '')}/`}
            >
              {latestBlog.data.title}
            </a>
            <p class="latest-excerpt">
              {latestBlog.data.description}
            </p>
          </div>
        ) : (
          <p class="latest-empty">No blog posts yet.</p>
        )}
      </article>

      <article class="homepage-card">
        <h2>Labs</h2>
        <p>
          Examine my hands-on investigations and experiments.
        </p>

        {latestLab ? (
          <div class="latest-preview">
            <p class="latest-label">Latest post</p>
            <a
              class="latest-title"
              href={`/labs/${latestLab.id.replace(/\.md$/, '')}/`}
            >
              {latestLab.data.title}
            </a>
            <p class="latest-excerpt">
              {latestLab.data.description}
            </p>
          </div>
        ) : (
          <p class="latest-empty">No lab posts yet.</p>
        )}
      </article>
    </section>
  </main>
</BaseLayout>