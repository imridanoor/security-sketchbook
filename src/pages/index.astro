---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sanity } from "../lib/sanity";

const latestBlog = await sanity.fetch(`
  *[_type == "blogPost"] | order(publishedAt desc)[0]{
    title,
    excerpt,
    "slug": slug.current
  }
`);

const latestLab = await sanity.fetch(`
  *[_type == "labPost"] | order(publishedAt desc)[0]{
    title,
    excerpt,
    "slug": slug.current
  }
`);

const latestSketch = await sanity.fetch(`
  *[_type == "sketchbookPost"] | order(publishedAt desc)[0]{
    title,
    excerpt,
    "slug": slug.current
  }
`);
---

<BaseLayout title="Security Sketchbook">
  <main class="container homepage-shell">

    <section class="hero">
      <h1>
        <span class="hero-kicker">Rida's</span>
        <span class="hero-main">Security Sketchbook</span>
      </h1>

      <p class="hero-subtitle">
        Visualizing cybersecurity concepts through diagrams and investigations.
      </p>
    </section>

    <section class="homepage-grid">

      <article class="homepage-card intro-card">
        <h2>What is Security Sketchbook?</h2>
        <p>
          This site is my personal notebook for learning cybersecurity.
          I document things I'm studying, diagrams I'm drawing, and
          investigations I'm working through.
        </p>
      </article>

      <article class="homepage-card">
  <h2>
    <a href="/sketchbook" class="card-section-link">Sketchbook</a>
  </h2>

  <p>
    Visit my visual diagrams of security systems and concepts re-imagined.
  </p>

  {latestSketch ? (
    <div class="latest-preview">
      <a class="latest-title" href={`/sketchbook/${latestSketch.slug}`}>
        {latestSketch.title}
      </a>

      {latestSketch.excerpt && (
        <p class="latest-excerpt">{latestSketch.excerpt}</p>
      )}
    </div>
  ) : (
    <p class="latest-empty">No sketchbook posts yet.</p>
  )}
</article>

      <article class="homepage-card">
  <h2>
    <a href="/blog" class="card-section-link">Blog</a>
  </h2>

  <p>
    Explore my explanations of concepts and ideas.
  </p>

  {latestBlog ? (
    <div class="latest-preview">
      <a class="latest-title" href={`/blog/${latestBlog.slug}`}>
        {latestBlog.title}
      </a>

      {latestBlog.excerpt && (
        <p class="latest-excerpt">{latestBlog.excerpt}</p>
      )}
    </div>
  ) : (
    <p class="latest-empty">No blog posts yet.</p>
  )}
</article>

      <article class="homepage-card">
  <h2>
    <a href="/labs" class="card-section-link">Labs</a>
  </h2>

  <p>
    Examine my hands-on investigations and experiments.
  </p>

  {latestLab ? (
    <div class="latest-preview">
      <a class="latest-title" href={`/labs/${latestLab.slug}`}>
        {latestLab.title}
      </a>

      {latestLab.excerpt && (
        <p class="latest-excerpt">{latestLab.excerpt}</p>
      )}
    </div>
  ) : (
    <p class="latest-empty">No lab posts yet.</p>
  )}
</article>

    </section>

  </main>
</BaseLayout>