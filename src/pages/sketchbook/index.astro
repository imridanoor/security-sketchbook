---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sanity, urlFor } from "../../lib/sanity";

const posts = await sanity.fetch(`
  *[_type == "sketchbookPost"] | order(publishedAt desc) {
    _id,
    title,
    "slug": slug.current,
    excerpt,
    publishedAt,
    medium,
    image,
    videoUrl
  }
`);
---

<BaseLayout title="Sketchbook | SecuritySketchbook">
  <main class="container">
    <h1>Sketchbook</h1>

    <div class="post-grid">
      {posts.map((post) => (
        <article class="post-card">
          <a href={`/sketchbook/${post.slug}/`}>
            {post.image && (
              <img
                src={urlFor(post.image).width(1200).url()}
                alt={post.image?.alt || post.title}
              />
            )}
            <h2>{post.title}</h2>
          </a>

          {post.excerpt && <p>{post.excerpt}</p>}
          {post.medium && <p><strong>Medium:</strong> {post.medium}</p>}
          {post.videoUrl && <p>Includes video</p>}
        </article>
      ))}
    </div>
  </main>
</BaseLayout>